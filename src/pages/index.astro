---
import Basis from '../layouts/Basis.astro';
import kunde from '../data/kunde.json';
import Start from '../components/Start.astro';
import KarriereBand from '../components/KarriereBand.astro';
import Leistungen from '../components/Leistungen.astro';
import UeberUns from '../components/UeberUns.astro';
import Anfahrt from '../components/Anfahrt.astro';
import Kontakt from '../components/Kontakt.astro';

const h = kunde.standorte[0];
const firmendaten = {
  '@context': 'https://schema.org',
  '@type': 'AutoRepair',
  name: kunde.firma,
  telephone: kunde.kontakt.telefon,
  email: kunde.kontakt.email,
  url: `https://${kunde.domain}`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: h.strasse,
    postalCode: h.ort.split(' ')[0],
    addressLocality: h.ort.split(' ').slice(1).join(' '),
    addressCountry: 'DE',
  },
  sameAs: kunde.social.filter((s) => s.url).map((s) => s.url),
};
---

<Basis strukturdaten={firmendaten}>
  <Start />
  <KarriereBand />
  <Leistungen />
  <UeberUns />
  <Anfahrt />
  <Kontakt />
</Basis>
