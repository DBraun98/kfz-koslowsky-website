---
import Basis from '../../layouts/Basis.astro';
import kunde from '../../data/kunde.json';
import { stellen, bewerbungsMail } from '../../lib/stellen.js';
import { url, telLink } from '../../lib/url.js';
import Icon from '../../components/Icon.astro';
import Hinweis from '../../components/Hinweis.astro';
import Platzhalter from '../../components/Platzhalter.astro';

const b = kunde.bewerbung;
// Die Vorteile der ersten echten Stelle stehen stellvertretend für den Betrieb.
const vorteile = (stellen.find((s) => !s.platzhalter) ?? stellen[0])?.angebot ?? [];
---

<Basis titel="Karriere" beschreibung={`Jobs bei ${kunde.firma} in Kirchdorf. Offene Stellen und schnelle Bewerbung.`}>
  <section class="kopfbereich">
    <div class="wrap kopfbereich__innen">
      <div>
        <h1>Arbeiten in einer Werkstatt, in der man sich kennt</h1>
        <p class="kopfbereich__intro">
          Wir sind ein kleiner KFZ-Meisterbetrieb in Kirchdorf und suchen Verstärkung für unser Team. Bewerben geht
          schnell – ein Anruf reicht für den Anfang.
        </p>
        <div class="kopfbereich__knoepfe">
          <a class="btn btn--rot" href="#stellen">Offene Stellen</a>
          <a class="btn btn--rahmen" href={telLink(kunde.kontakt.telefon)}>
            <Icon name="telefon" />
            {kunde.kontakt.telefonAnzeige}
          </a>
        </div>
      </div>
      <Platzhalter label="Foto: Mitarbeiter bei der Arbeit" format="4 / 3" />
    </div>
  </section>

  <section id="stellen" class="abschnitt">
    <div class="wrap">
      <h2>Offene Stellen</h2>

      {
        stellen.length === 0 ? (
          <p class="einleitung">
            Gerade ist keine Stelle ausgeschrieben. Melde dich trotzdem gern – gute Leute suchen wir immer.
          </p>
        ) : (
          <ul class="stellen">
            {stellen.map((s) => (
              <li class="stelle">
                <div class="stelle__text">
                  <h3>
                    <a href={url(`karriere/${s.slug}/`)}>{s.titel}</a>
                    {kunde.entwurf && s.platzhalter && <span class="stelle__platzhalter">Platzhalter</span>}
                  </h3>
                  <ul class="stelle__merkmale">
                    <li class="merkmal">{s.art}</li>
                    <li class="merkmal">{s.start}</li>
                    <li class="merkmal">{s.ort}</li>
                  </ul>
                  <p>{s.kurz}</p>
                </div>
                <a class="btn btn--navy" href={url(`karriere/${s.slug}/`)}>
                  Stelle ansehen
                  <span class="unsichtbar">: {s.titel}</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>

  {
    vorteile.length > 0 && (
      <section class="abschnitt abschnitt--beton">
        <div class="wrap vorteile">
          <div>
            <h2>Warum bei uns</h2>
            <p class="einleitung">
              Bei uns bist du keine Personalnummer. Du arbeitest an Autos aller Marken und weißt, wen du fragen kannst.
            </p>
          </div>
          <ul class="hakenliste vorteile__liste">
            {vorteile.map((v) => (
              <li>
                <Icon name="haken" />
                <span>{v}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="abschnitt">
    <div class="wrap">
      <h2>So bewirbst du dich</h2>
      <p class="einleitung">{b.text}</p>
      <ol class="schritte">
        {
          b.schritte.map((s, i) => (
            <li>
              <span class="schritte__nr">{i + 1}</span>
              <h3>{s.titel}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
      <Hinweis text={b.todo} />

      <div class="initiativ">
        <div>
          <h3>Nichts Passendes dabei?</h3>
          <p>Schreib uns trotzdem. Wir melden uns bei dir.</p>
        </div>
        <div class="initiativ__knoepfe">
          <a class="btn btn--rot" href={bewerbungsMail(null)}>
            <Icon name="mail" />
            Initiativ bewerben
          </a>
          <a class="btn btn--rahmen-dunkel" href={telLink(kunde.kontakt.telefon)}>
            <Icon name="telefon" />
            Anrufen
          </a>
        </div>
      </div>
    </div>
  </section>
</Basis>

<style>
  .kopfbereich {
    background: var(--navy);
    color: var(--weiss);
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  .kopfbereich__innen {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .kopfbereich h1 {
    font-size: clamp(2.3rem, 5vw, 3.8rem);
  }

  .kopfbereich__intro {
    font-size: 1.25rem;
    color: #d5dee8;
  }

  .kopfbereich__knoepfe {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.8rem;
  }

  .stellen {
    list-style: none;
    border-top: 1px solid var(--linie);
  }

  .stelle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    padding-block: 1.8rem;
    border-bottom: 1px solid var(--linie);
  }

  .stelle h3 {
    font-size: clamp(1.4rem, 2.6vw, 1.8rem);
    font-weight: 700;
    margin-bottom: 0.6rem;
  }

  .stelle h3 a {
    color: var(--navy);
    text-decoration: none;
  }

  .stelle h3 a:hover {
    color: var(--rot);
  }

  .stelle__platzhalter {
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0.1rem 0.5rem;
    font-size: 0.85rem;
    font-family: var(--schrift-text);
    font-weight: 600;
    background: var(--gelb);
    border: 1px dashed var(--gelb-rand);
    border-radius: var(--radius);
    vertical-align: middle;
  }

  .stelle__merkmale {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.8rem;
  }

  .stelle p {
    margin: 0;
  }

  .stelle .btn {
    flex: none;
  }

  .vorteile {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem 4rem;
    align-items: start;
  }

  .vorteile__liste {
    font-size: 1.2rem;
    gap: 0.9rem;
  }

  .schritte {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    counter-reset: none;
  }

  .schritte__nr {
    display: grid;
    place-items: center;
    width: 2.8rem;
    height: 2.8rem;
    margin-bottom: 0.8rem;
    border-radius: 50%;
    background: var(--rot);
    color: var(--weiss);
    font-family: var(--schrift-titel);
    font-weight: 700;
    font-size: 1.4rem;
  }

  .schritte h3 {
    color: var(--navy);
    margin-bottom: 0.3rem;
  }

  .schritte p {
    margin: 0;
  }

  .initiativ {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    margin-top: 3.5rem;
    padding: 1.8rem 2rem;
    background: var(--beton);
    border-radius: var(--radius);
  }

  .initiativ h3 {
    color: var(--navy);
    margin-bottom: 0.2rem;
  }

  .initiativ p {
    margin: 0;
  }

  .initiativ__knoepfe {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  @media (max-width: 820px) {
    .kopfbereich__innen,
    .vorteile {
      grid-template-columns: 1fr;
    }

    .stelle {
      flex-direction: column;
      align-items: flex-start;
    }

    .schritte {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
