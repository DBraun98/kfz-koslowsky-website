---
import kunde from '../data/kunde.json';
import { url, telLink } from '../lib/url.js';
import Icon from './Icon.astro';
import Plakette from './Plakette.astro';
---

<section class="start">
  <svg class="start__linie" viewBox="0 0 1440 420" preserveAspectRatio="none" aria-hidden="true">
    <path d="M-40 400 C 260 170, 620 60, 980 90 S 1360 250, 1500 360"></path>
  </svg>

  <div class="wrap start__innen">
    <div class="start__text">
      <h1>{kunde.claim}</h1>
      <p class="start__intro">{kunde.intro}</p>

      <div class="start__knoepfe">
        <a class="btn btn--rot" href={telLink(kunde.kontakt.telefon)}>
          <Icon name="telefon" />
          {kunde.kontakt.telefonAnzeige}
        </a>
        <a class="btn btn--rahmen" href={url('#anfahrt')}>Öffnungszeiten und Anfahrt</a>
      </div>

      <ul class="hakenliste start__fakten">
        {
          kunde.fakten.map((f) => (
            <li>
              <Icon name="haken" />
              <span>{f}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="start__plakette">
      <Plakette oben="HU/AU" mitte={kunde.huau.tageKurz} unten="jede Woche" />
    </div>
  </div>
</section>

<style>
  .start {
    position: relative;
    overflow: hidden;
    background: var(--navy);
    color: var(--weiss);
    padding-block: clamp(3.5rem, 9vw, 7rem);
  }

  .start__linie {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .start__linie path {
    fill: none;
    stroke: var(--rot);
    stroke-width: 3;
    vector-effect: non-scaling-stroke;
    opacity: 0.85;
  }

  .start__innen {
    position: relative;
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .start__intro {
    font-size: clamp(1.15rem, 2vw, 1.35rem);
    color: #d5dee8;
    max-width: 44ch;
  }

  .start__knoepfe {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-block: 2rem;
  }

  .start__fakten {
    color: #e6ecf2;
  }

  .start__fakten :global(svg) {
    color: #ff5a6a;
  }

  .start__plakette {
    display: flex;
    justify-content: center;
  }

  @media (max-width: 820px) {
    .start__innen {
      grid-template-columns: 1fr;
    }

    .start__plakette {
      order: -1;
      justify-content: flex-start;
    }

    .start__plakette :global(.plakette) {
      width: 11rem;
    }
  }
</style>
