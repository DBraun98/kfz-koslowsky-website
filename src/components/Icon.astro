};

const { name, klasse = '' } = Astro.props;
const d = pfade[name] ?? '';
---

<svg
  class={klasse}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d={d}></path>
</svg>
